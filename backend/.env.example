# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
# Local MongoDB or MongoDB Atlas URI:
MONGO_URI=mongodb://127.0.0.1:27017/hireflow
# If set to true, starts an in-memory Mongo server when local Mongo is unavailable:
USE_MEMORY_DB=true

# JWT Configuration
JWT_SECRET=hireflow_super_secret_jwt_key_2026_production_grade
JWT_EXPIRE=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Cloudinary Configuration (Optional - defaults to local uploads if not provided)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
